# ---------------------------------------------------------------------------
# NES COD Camo Tracker - Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL connection
# Either provide DATABASE_URL, or the discrete PG* vars below.
DATABASE_URL=postgres://nes_user:changeme@localhost:5432/nes_cod_tracker
PGSSL=false

# Session / cookie secrets
# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

# Cookie behavior
COOKIE_SECURE=false
# Set COOKIE_SECURE=true in production (requires HTTPS)

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120

# File uploads (admin camo image uploads)
MAX_UPLOAD_BYTES=2097152

# Initial admin bootstrap (used only by seed script, optional)
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
